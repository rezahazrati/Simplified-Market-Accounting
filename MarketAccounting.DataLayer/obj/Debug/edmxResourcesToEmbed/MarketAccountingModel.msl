        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="PWYBF">
      <EntityTypeMapping TypeName="IsTypeOf(MarketAccounting_DBModel.PWYBF)">
        <MappingFragment StoreEntitySet="PWYBF">
          <ScalarProperty Name="PWYBFId" ColumnName="PWYBFId" />
