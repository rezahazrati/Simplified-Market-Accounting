        <MappingFragment StoreEntitySet="SlAndBu">
          <ScalarProperty Name="SlAndBuId" ColumnName="SlAndBuId" />
          <ScalarProperty Name="TypeId" ColumnName="TypeId" />
          <ScalarProperty Name="NumberOfProduct" ColumnName="NumberOfProduct" />
          <ScalarProperty Name="TotalCost" ColumnName="TotalCost" />
          <ScalarProperty Name="DateTime" ColumnName="DateTime" />
          <ScalarProperty Name="NameOfCustomer" ColumnName="NameOfCustomer" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="TypeId">
      <EntityTypeMapping TypeName="IsTypeOf(MarketAccounting_DBModel.TypeId)">
        <MappingFragment StoreEntitySet="TypeId">
          <ScalarProperty Name="TypeId1" ColumnName="TypeId1" />
          <ScalarProperty Name="What" ColumnName="What" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Customers">
      <EntityTypeMapping TypeName="IsTypeOf(MarketAccounting_DBModel.Customers)">
        <MappingFragment StoreEntitySet="Customers">
          <ScalarProperty Name="CustomerId" ColumnName="CustomerId" />
          <ScalarProperty Name="CustomerName" ColumnName="CustomerName" />
